# What Git must never upload. Private, game-owned or generated files stay on your own PC.
# (Comments must be on their own line in this file.)

# --- PRIVATE: never share ---
# capture: live login tokens and traffic from your account
capture/
# backup: includes the pak decryption key (backup/keys) and original game files
backup/
# dumps: data dumped out of the game itself
dumps/
tools/offline-audit/data/
# edited game meshes / game assets (rebuild with tools/female/make_female.py)
assets/female/pak/
assets/female/src/
# the loading video contains a song: this install only
assets/intro/
# trailer and cinematic camera tooling: local only, not part of the mod
trailer/

# --- your own saves, settings and logs ---
backend/state*.json
backend/saves/
backend/joiners/
# the launcher's marker for the save in play (launcher/saves.py ACTIVE)
backend/active_save.txt
backend/loadout.json
backend/cosmetics.json
backend/checkout.txt
backend/ship_*.txt
backend/gifts_in.txt
backend/coverage.json
backend/*.log
backend/crew*.lua
config/game_path.txt
config/female_player.txt
config/female_share.txt
config/raid_map.txt
config/unlock_all_looks.txt
config/outfit_body.txt
config/guild.txt
config/window_mode.txt
config/player_level.txt
config/skip_intro.txt
config/update_check.txt
config/minimize_while_playing.txt
config/minimap.txt
config/stash_rows.txt
config/crew_meshes.lua
*.log
*.lnk

# --- runtime scratch folders (the game reads/writes these while running) ---
bridge/*
!bridge/offline_backend
bridge[0-9]*/
tmp[0-9]*/

# --- built or downloaded files ---
/release/
tools/release/private.txt
tools/release/__pycache__/
tools/ue4ss/
tools/repak/
*.zip
*.whl
mods/*/Scripts/pveproject.lua
native/*.exe
native/*.dll
# the two DLLs the mod needs at runtime are kept so contributors don't need a compiler
!native/pvenet.dll
!native/pvepatch.dll
__pycache__/
*.pyc

# Ahtu's full-size map sources (~14 MB each): tools/minimap/ahtu_align.py reads them, only its output is kept
assets/minimap/ahtu/ahtu-*.png
config/raid_condition.txt
config/coop_host.txt
config/coop_join.txt
config/coop_last.txt
config/my_raid_conditions.txt
